  static tr(zh: string): string {
    const lang: string = AppStorage.get<string>('appLang') ?? 'zh';
    if (lang !== 'en') {
      return zh;
    }
    const en: string | undefined = I18n.EN[zh];
    return en ?? zh;
  }
}

export function tr(zh: string): string {
  return I18n.tr(zh);
}

export function trf(zh: string, ...args: (string | number)[]): string {
  let s: string = I18n.tr(zh);
  for (let i = 0; i < args.length; i++) {
    s = s.split('{' + i + '}').join('' + args[i]);
  }
  return s;
}

export function trEq(candidate: string, zh: string): boolean {
  return candidate === zh || candidate === I18n.tr(zh);
}
