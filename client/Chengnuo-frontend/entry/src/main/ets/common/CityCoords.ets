const COORD_MAP: Map<string, GeoCoord> = buildCoordMap();

function buildCoordMap(): Map<string, GeoCoord> {
  const map: Map<string, GeoCoord> = new Map();
  for (let i = 0; i < COORD_ROWS.length; i++) {
    const parts: string[] = COORD_ROWS[i].split('|');
    if (parts.length !== 3) {
      continue;
    }
    const ll: string[] = parts[2].split(',');
    if (ll.length !== 2) {
      continue;
    }
    const lat: number = Number(ll[0]);
    const lng: number = Number(ll[1]);
    if (Number.isNaN(lat) || Number.isNaN(lng)) {
      continue;
    }
    map.set(`${parts[0]}|${parts[1]}`, new GeoCoord(lat, lng));
  }
  return map;
}

/**
 * 坐标 → 城市坐标表中最近城市（自动定位反查；经度差按中点纬度余弦折算）。
 * 离线反查：不依赖系统地理编码服务（模拟器/非华为设备不可用），城市级精度满足天气展示。
 */
export function nearestRegion(lat: number, lng: number): RegionSelection | null {
  let best: RegionSelection | null = null;
  let bestDist: number = Number.MAX_VALUE;
  for (let p = 0; p < REGION_PROVINCES.length; p++) {
    const province = REGION_PROVINCES[p];
    for (let c = 0; c < province.cities.length; c++) {
      const coord: GeoCoord | undefined = COORD_MAP.get(`${province.name}|${province.cities[c]}`);
      if (coord === undefined) {
        continue;
      }
      const midLatRad: number = ((lat + coord.lat) / 2) * Math.PI / 180;
      const dLat: number = lat - coord.lat;
      const dLng: number = (lng - coord.lng) * Math.cos(midLatRad);
      const dist: number = dLat * dLat + dLng * dLng;
      if (dist < bestDist) {
        bestDist = dist;
        best = new RegionSelection(province.name, province.cities[c]);
      }
    }
  }
  return best;
}

/** 省|市 → 城市坐标（天气上送经纬度用；表中无此城市返回 null） */
export function coordOf(province: string, city: string): GeoCoord | null {
  return COORD_MAP.get(`${province}|${city}`) ?? null;
}
