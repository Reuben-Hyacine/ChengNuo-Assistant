/** 经纬度 */
export class GeoCoord {
  readonly lat: number;
  readonly lng: number;

  constructor(lat: number, lng: number) {
    this.lat = lat;
    this.lng = lng;
  }
}

/** 省市反查结果（坐标 → 最近城市） */
export class RegionSelection {
  readonly province: string;
  readonly city: string;

  constructor(province: string, city: string) {
    this.province = province;
    this.city = city;
  }
}

